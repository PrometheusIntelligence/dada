    "steel":   { "name": "Steel Pact",       "blurb": "Foundry cities under one banner.",  "main": "#cdd5e3", "dark": "#6f7b92", "tone": "light", "emblem": "vee", "flag": "pennant" },
    "crimson": { "name": "Crimson Republic", "blurb": "A revolutionary mass army.",        "main": "#a62d27", "dark": "#5c1612", "tone": "dark",  "emblem": "block",     "flag": "square" },
    "violet":  { "name": "Violet League",    "blurb": "Mountain clans with long guns.",    "main": "#6a3fb0", "dark": "#3a2270", "tone": "dark",  "emblem": "ell",   "flag": "swallow" },
    "pine":    { "name": "Pine Dominion",    "blurb": "Forest state, patient and armoured.", "main": "#2a6a42", "dark": "#143a24", "tone": "dark",  "emblem": "slash", "flag": "pennant" }
