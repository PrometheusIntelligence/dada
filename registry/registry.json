{
  "$schema": "../skills/dada/schema/dada-registry.schema.json",
  "registry_version": "1.0",
  "name": "dada",
  "description": "The one list of what dada and its forks use: skills, MCP servers and manuals, with where each skill attaches. SKILL.md and the manuals stay the contract; this is how the three stay consistent. scripts/validate_registry.py fails when they drift. Forks list themselves under `forks` and keep their own manual, servers and attachments in their own registry, which extends this one.",
  "manuals": [
    {
      "name": "dada",
      "path": "skills/dada/runtypes/dada.manual.json",
      "repo": "PrometheusIntelligence/dada"
    }
  ],
  "servers": [
    {
      "id": "gm",
      "kind": "workflow",
      "repo": "AnEntrypoint/gm",
      "transport": "stdio",
      "used_by": [],
      "description": "Project workflow MCP dada's AGENTS.md names for codesearch and git verbs. Not a manual instrument; 3dada uses the gm-lite skill instead and no daemon."
    }
  ],
